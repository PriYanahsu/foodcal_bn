# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=foodcal
DB_USER=postgres
DB_PASSWORD=

# JWT — secret must be at least 32 bytes for HS256. Expirations are MILLISECONDS.
JWT_SECRET=
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Allowed CORS origin(s), comma-separated
FRONTEND_URL=http://localhost:3000

# Supabase Storage — service-role key is server-side only, never ship it to a client
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars
SUPABASE_MEAL_IMAGE_BUCKET=meal-images

# Optional, defaults to 8080
PORT=8080
